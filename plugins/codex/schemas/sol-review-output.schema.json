{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sol Review Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "specVerdict", "qualityVerdict", "summary", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "specVerdict": { "enum": ["pass", "fail", "cannot-verify"] },
    "qualityVerdict": { "enum": ["approve", "changes-required"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "evidence", "impact", "recommendation", "confidence", "locations"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["critical", "important", "minor"] },
          "title": { "type": "string" },
          "evidence": { "type": "string" },
          "impact": { "type": "string" },
          "recommendation": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "locations": { "type": "array", "items": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" }, "line": { "type": ["integer", "null"], "minimum": 1 } }, "additionalProperties": false } },
          "supersedes": { "type": "array", "items": { "type": "string" } },
          "duplicateOf": { "type": ["string", "null"] }
        }
      }
    }
  }
}
